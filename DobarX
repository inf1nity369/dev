        <p style={{ color: "rgba(195,182,225,0.55)", fontSize: "0.95rem", fontFamily: "'Syne',sans-serif", margin: 0 }}>
          Drag or swipe to browse — click any card to focus
        </p>
      </div>

      {/*
        ── CAROUSEL TRACK ──────────────────────────────────────────────────────
        overflow-x: scroll with hidden scrollbar + drag-to-scroll.
        Padding on both sides ensures the first/last card can center.
      */}
      <div
        ref={trackRef}
        onScroll={onScroll}
        onMouseDown={onMouseDown}
        onMouseMove={onMouseMove}
        onMouseUp={onMouseUp}
        onMouseLeave={onMouseUp}
        style={{
          display: "flex",
          alignItems: "center",
          gap: GAP,
          overflowX: "scroll",
          overflowY: "visible",
          cursor: "grab",
          userSelect: "none",
          WebkitOverflowScrolling: "touch",
          // Hide scrollbar cross-browser
          scrollbarWidth: "none",
          msOverflowStyle: "none",
          // Tall enough to show glows without clip
          paddingTop: 40,
          paddingBottom: 52,
          // Horizontal padding = half viewport so first/last card can center
          paddingLeft: `calc(50vw - ${CARD_W / 2}px)`,
          paddingRight: `calc(50vw - ${CARD_W / 2}px)`,
        }}
      >
        {AD_CARDS.map((card, i) => {
          const isActive = i === activeIdx;
          // Distance from center: 0 = center, 1 = one slot away, etc.
          const dist = Math.abs(i - activeIdx);
          const scale   = isActive ? 1 : Math.max(0.72, 1 - dist * 0.1);
          const opacity = isActive ? 1 : Math.max(0.28, 1 - dist * 0.28);
          // 3-D tilt: cards to the left lean right, cards to the right lean left
          const rotateY = isActive ? 0 : (i < activeIdx ? 14 : -14);
          const rotateZ = isActive ? 0 : (i < activeIdx ? 1.5 : -1.5);

          return (
            <div
              key={card.id}
              onClick={() => goTo(i)}
              style={{
                flexShrink: 0,
                width: CARD_W,
                // Outer container handles 3D perspective + transforms
                transform: `scale(${scale}) perspective(900px) rotateY(${rotateY}deg) rotateZ(${rotateZ}deg)`,
                opacity,
                transition: "transform 0.45s cubic-bezier(0.25,0.46,0.45,0.94), opacity 0.45s ease, filter 0.45s ease",
                cursor: isActive ? "default" : "pointer",
                // Active card drops a large coloured shadow
                filter: isActive
                  ? `drop-shadow(0 0 28px ${card.accent}88) drop-shadow(0 16px 48px ${card.accent}44)`
                  : "none",
                // Keep transform-origin at center so scaling looks natural
                transformOrigin: "center center",
                position: "relative",
                zIndex: isActive ? 10 : Math.max(1, 5 - dist),
              }}
            >
              {/* Phone shell */}
              <div style={{
                width: CARD_W,
                height: CARD_H + 36,
                borderRadius: 28,
                background: "linear-gradient(145deg,#18182e,#0c0c1a)",
                border: isActive
                  ? `1.5px solid ${card.accent}`
                  : "1px solid rgba(255,255,255,0.08)",
                boxShadow: isActive
                  ? `0 0 0 1px ${card.accent}44, inset 0 0 24px ${card.accent}18`
                  : "inset 0 0 0 1px rgba(255,255,255,0.04)",
                transition: "border 0.4s ease, box-shadow 0.4s ease",
                position: "relative",
                overflow: "visible",
                padding: "18px 6px 6px",
                boxSizing: "border-box" as const,
              }}>
                {/* Notch */}
                <div style={{ position: "absolute", top: 7, left: "50%", transform: "translateX(-50%)", width: 38, height: 5, background: "#09091a", borderRadius: 4, zIndex: 10 }} />

                {/* 9:16 Screen */}
                <div style={{
                  width: CARD_W - 12,
                  height: CARD_H,
                  borderRadius: 14,
                  overflow: "hidden",
                  position: "relative",
                  background: "#000",
                }}>
                  {/* Gradient fallback (always behind video) */}
                  <div style={{ position: "absolute", inset: 0, background: card.fallback, zIndex: 0 }} />

                  {/*
                    ── VIDEO ─────────────────────────────────────────────────
                    src comes from AD_CARDS[i].src above.
                    Active card plays; all others are paused and reset.
                    To add more ads: add entries to the AD_CARDS array.
                  */}
                  <video
                    ref={el => { videoRefs.current[i] = el; }}
                    muted
                    loop
                    playsInline
                    poster={card.poster}
                    style={{
                      position: "absolute", inset: 0,
                      width: "100%", height: "100%",
                      objectFit: "cover", objectPosition: "center",
                      borderRadius: 14,
                      zIndex: 1,
                      // Smooth fade-in when video becomes active
                      opacity: isActive ? 1 : 0.6,
                      transition: "opacity 0.4s ease",
                    }}
                  >
                    <source src={card.src} type="video/mp4" />
                    <source src={card.src.replace(".mp4", ".webm")} type="video/webm" />
                  </video>

                  {/* Play icon on inactive cards */}
                  {!isActive && (
                    <div style={{
                      position: "absolute", inset: 0, zIndex: 3,
                      display: "flex", alignItems: "center", justifyContent: "center",
                    }}>
                      <div style={{
                        width: 32, height: 32, borderRadius: "50%",
                        background: "rgba(0,0,0,0.55)",
                        backdropFilter: "blur(4px)",
                        display: "flex", alignItems: "center", justifyContent: "center",
                      }}>
                        <span style={{ fontSize: 12, marginLeft: 2 }}>▶</span>
                      </div>
                    </div>
                  )}

                  {/* Tag badge */}
                  <div style={{
                    position: "absolute", top: 8, left: 8, zIndex: 5,
                    background: `rgba(${hexRgb(card.accent)},0.85)`,
                    backdropFilter: "blur(4px)",
                    borderRadius: 5, padding: "2px 7px",
                    fontSize: 7, fontWeight: 800, letterSpacing: "0.14em",
                    color: "#fff", textTransform: "uppercase",
                    fontFamily: "'Syne',sans-serif",
                  }}>
                    {card.tag}
                  </div>

                  {/* Glare */}
                  <div style={{ position: "absolute", inset: 0, borderRadius: 14, background: "linear-gradient(135deg,rgba(255,255,255,0.06) 0%,transparent 45%)", pointerEvents: "none", zIndex: 6 }} />
                </div>

                {/* Side button */}
                <div style={{ position: "absolute", right: -2, top: 52, width: 2, height: 24, background: "rgba(255,255,255,0.1)", borderRadius: "0 2px 2px 0" }} />
              </div>

              {/* Card title below phone */}
              <div style={{ marginTop: 14, textAlign: "center" }}>
                <p style={{
                  fontFamily: "'Syne',sans-serif", fontSize: 11, fontWeight: 700,
                  color: isActive ? "#fff" : "rgba(200,190,230,0.38)",
                  letterSpacing: "0.04em", margin: 0,
                  transition: "color 0.4s ease",
                }}>
                  {card.title}
                </p>
              </div>
            ))}
          </div>
          <div className="flex justify-center order-1 md:order-2">
            <div className="relative w-[280px] aspect-[9/16] bg-black rounded-[3rem] border-[10px] border-[#1e293b] shadow-2xl overflow-hidden">
              <video 
                key={activePhase}
                src={strategyData[activePhase].video}
                autoPlay loop muted playsInline
                className="w-full h-full object-cover"
              />
            </div>
          </div>
          );
        })}
      </div>

      {/* Dot navigation */}
      <div style={{ display: "flex", justifyContent: "center", gap: 8, marginTop: 4 }}>
        {AD_CARDS.map((card, i) => (
          <button
            key={card.id}
            onClick={() => goTo(i)}
            aria-label={`Go to ${card.title}`}
            style={{
              width: i === activeIdx ? 24 : 7,
              height: 7,
              borderRadius: 4,
              border: "none",
              background: i === activeIdx ? card.accent : "rgba(255,255,255,0.18)",
              boxShadow: i === activeIdx ? `0 0 10px ${card.accent}` : "none",
              cursor: "pointer",
              padding: 0,
              transition: "all 0.35s ease",
            }}
          />
        ))}
      </div>

      {/* Webkit scrollbar hide */}
      <style>{`.ad-archive-track::-webkit-scrollbar{display:none}`}</style>
    </section>
  );
};

// ─── Cosmic Hero ──────────────────────────────────────────────────────────────
const CosmicHero = () => {
  const canvasRef = useRef<HTMLCanvasElement>(null);
  const svgRef    = useRef<SVGSVGElement>(null);
  const compRef   = useRef<HTMLDivElement>(null);
  const screenRef = useRef<HTMLDivElement>(null);
  const cardRefs  = useRef<(HTMLDivElement | null)[]>([]);
  const [phase, setPhase] = useState(0);

  const activePhase   = PHASES[phase];
  const videoSrc      = activePhase.videoSrc;
  const fallbackGrad  = VID_FALLBACKS[videoSrc] ?? "linear-gradient(160deg,#1a1aff,#8f00ff)";
  const activeCaption = CAPTIONS[videoSrc] ?? "Going viral 🚀";

  // Starfield canvas
  useEffect(() => {
    const canvas = canvasRef.current; if (!canvas) return;
    const ctx = canvas.getContext("2d")!;
    let animId: number;
    const resize = () => { canvas.width = canvas.offsetWidth; canvas.height = canvas.offsetHeight; };
    resize();
    window.addEventListener("resize", resize);
    const STARS = Array.from({ length: 200 }, () => ({
      x: Math.random(), y: Math.random(),
      r: Math.random() * 1.2 + 0.15,
      speed: Math.random() * 0.00009 + 0.00002,
      opacity: Math.random() * 0.55 + 0.15,
    }));
    const draw = () => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      STARS.forEach(s => {
        s.x += s.speed; if (s.x > 1) s.x = 0;
        ctx.beginPath();
        ctx.arc(s.x * canvas.width, s.y * canvas.height, s.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(210,218,255,${s.opacity})`;
        ctx.fill();
      });
      animId = requestAnimationFrame(draw);
    };
    draw();
    return () => { cancelAnimationFrame(animId); window.removeEventListener("resize", resize); };
  }, []);

  // SVG connector lines
  useEffect(() => {
    const drawLines = () => {
      const svg = svgRef.current, comp = compRef.current, screen = screenRef.current;
      if (!svg || !comp || !screen) return;
      if (window.innerWidth <= 900) { svg.innerHTML = ""; return; }
      const cR = comp.getBoundingClientRect();
      const sR = screen.getBoundingClientRect();
      svg.setAttribute("viewBox", `0 0 ${cR.width} ${cR.height}`);
      svg.style.width  = `${cR.width}px`;
      svg.style.height = `${cR.height}px`;
      svg.innerHTML = "";
      const sl = sR.left - cR.left, st = sR.top - cR.top, sh = sR.height;
      const zY = [sh * 0.167, sh * 0.5, sh * 0.833];
      PHASES.forEach((p, i) => {
        const card = cardRefs.current[i]; if (!card) return;
        const dR = card.getBoundingClientRect();
        const cx = dR.right - cR.left, cy = (dR.top + dR.bottom) / 2 - cR.top;
        const tx = sl, ty = st + zY[i];
        const mx = (cx + tx) / 2;
        const isA = i === phase;
        const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
        path.setAttribute("d", `M${cx},${cy} C${mx},${cy} ${mx},${ty} ${tx},${ty}`);
        path.setAttribute("stroke", p.accent);
        path.setAttribute("stroke-width", isA ? "1.5" : "1");
        path.setAttribute("fill", "none");
        path.setAttribute("opacity", isA ? "0.75" : "0.1");
        path.setAttribute("stroke-dasharray", "4,5");
        path.style.transition = "opacity 0.5s ease";
        const dot = document.createElementNS("http://www.w3.org/2000/svg", "circle");
        dot.setAttribute("cx", String(tx)); dot.setAttribute("cy", String(ty));
        dot.setAttribute("r", isA ? "4" : "3");
        dot.setAttribute("fill", p.accent);
        dot.setAttribute("opacity", isA ? "1" : "0.12");
        svg.appendChild(path); svg.appendChild(dot);
      });
    };
    drawLines();
    let t: ReturnType<typeof setTimeout>;
    const onResize = () => { clearTimeout(t); t = setTimeout(drawLines, 120); };
    window.addEventListener("resize", onResize);
    return () => window.removeEventListener("resize", onResize);
  }, [phase]);

  const PW = 148, PH = Math.round(PW * 16 / 9);

  return (
    <section style={{
      position: "relative", minHeight: "100vh",
      display: "flex", flexDirection: "column",
      alignItems: "center", justifyContent: "center",
      overflow: "hidden", paddingTop: 80, paddingBottom: 80,
      background: "radial-gradient(ellipse 90% 70% at 50% 30%, #0e0628 0%, #060312 55%, #000 100%)",
    }}>
      <canvas ref={canvasRef} style={{ position: "absolute", inset: 0, width: "100%", height: "100%", pointerEvents: "none" }} />
      <div style={{ position: "absolute", width: 700, height: 500, borderRadius: "50%", background: "radial-gradient(circle,rgba(100,20,220,0.14) 0%,transparent 70%)", top: "-8%", left: "50%", transform: "translateX(-50%)", filter: "blur(60px)", pointerEvents: "none" }} />
      <div style={{ position: "absolute", width: 350, height: 350, borderRadius: "50%", background: "radial-gradient(circle,rgba(0,160,255,0.08) 0%,transparent 70%)", bottom: "5%", left: "20%", filter: "blur(50px)", pointerEvents: "none" }} />

      {/* Hero text */}
      <div style={{ position: "relative", zIndex: 2, display: "flex", flexDirection: "column", alignItems: "center", textAlign: "center", maxWidth: 680, padding: "0 24px", marginBottom: 56 }}>
        <div style={{ display: "inline-flex", alignItems: "center", gap: 8, background: "rgba(120,30,255,0.15)", border: "1px solid rgba(160,100,255,0.3)", borderRadius: 100, padding: "5px 16px", marginBottom: 28 }}>
          <span style={{ fontSize: 10, letterSpacing: "0.18em", color: "#c4a0ff", textTransform: "uppercase", fontWeight: 700, fontFamily: "'Syne',sans-serif" }}>✨ HIGH-RETENTION VIDEO ADS</span>
        </div>
      </section>

      {/* 4. PREMIUM AD ARCHIVE */}
      <section className="relative z-10 py-24 border-t border-white/5">
        <h3 className="text-center text-3xl font-black mb-16 tracking-tighter uppercase">Premium Ad Archive</h3>
        <div 
          ref={scrollContainerRef}
          className="flex gap-8 overflow-x-auto px-10 pb-12 no-scrollbar snap-x snap-mandatory"
        >
          {portfolioAds.map((ad) => (
            <div 
              key={ad.id}
              className="min-w-[300px] aspect-[9/16] bg-gray-900/50 rounded-3xl snap-center border border-white/10 hover:border-blue-500/50 transition-all overflow-hidden relative group"
            >
              <video src={ad.url} loop muted playsInline className="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity" />
              <div className="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity p-6 flex flex-col justify-end">
                <p className="text-xs font-bold tracking-widest text-blue-400 uppercase">Case Study</p>
                <p className="text-lg font-bold">{ad.title}</p>
        <h1 style={{ fontSize: "clamp(2rem,4.8vw,3.6rem)", fontWeight: 800, lineHeight: 1.1, letterSpacing: "-0.03em", color: "#fff", margin: "0 0 20px", fontFamily: "'Syne',sans-serif" }}>
          Scroll-Stopping UGC & VSL Ads{" "}
          <span style={{ background: "linear-gradient(90deg,#a855f7,#38bdf8,#a855f7)", backgroundSize: "200% auto", WebkitBackgroundClip: "text", WebkitTextFillColor: "transparent", animation: "shimmer 3.5s linear infinite" }}>
            That Convert.
          </span>
        </h1>
        <p style={{ fontSize: "clamp(0.95rem,1.8vw,1.1rem)", color: "rgba(195,182,225,0.7)", lineHeight: 1.7, marginBottom: 36, maxWidth: 520, fontFamily: "'Syne',sans-serif" }}>
          We craft raw, highly-engaging 9:16 video ads designed specifically to scale your e-commerce brand and drop CPA.
        </p>
        <div style={{ display: "flex", gap: 12, flexWrap: "wrap", justifyContent: "center" }}>
          <button style={{ background: "linear-gradient(135deg,#7b1fff,#2563eb)", color: "#fff", border: "none", borderRadius: 12, padding: "13px 32px", fontSize: "0.95rem", fontWeight: 700, cursor: "pointer", boxShadow: "0 0 32px rgba(120,30,255,0.4)", fontFamily: "'Syne',sans-serif", letterSpacing: "0.01em" }}>
            Book a Call →
          </button>
          <button style={{ background: "rgba(255,255,255,0.05)", color: "rgba(210,200,240,0.9)", border: "1px solid rgba(255,255,255,0.1)", borderRadius: 12, padding: "13px 26px", fontSize: "0.95rem", fontWeight: 600, cursor: "pointer", fontFamily: "'Syne',sans-serif" }}>
            View Portfolio
          </button>
        </div>
      </div>

      {/* Phone + Cards */}
      <div ref={compRef} className="phone-composition" style={{ position: "relative", zIndex: 2, display: "flex", alignItems: "center", justifyContent: "center", gap: 0 }}>
        <svg ref={svgRef} style={{ position: "absolute", top: 0, left: 0, pointerEvents: "none", overflow: "visible", zIndex: 2 }} />

        {/* Strategy cards */}
        <div className="strategy-cards" style={{ display: "flex", flexDirection: "column", gap: 10, marginRight: 28, zIndex: 3 }}>
          {PHASES.map((p, i) => {
            const isActive = phase === i;
            return (
              <div key={i} ref={el => cardRefs.current[i] = el}>
                <GlassCard accent={p.accent} isActive={isActive} onClick={() => setPhase(i)}
                  style={{ width: 188, padding: "12px 14px 16px", position: "relative", overflow: "hidden", opacity: isActive ? 1 : 0.38, transform: isActive ? "scale(1.04)" : "scale(1)" }}>
                  {!isActive && (
                    <div className="card-hover-hint" style={{ position: "absolute", inset: 0, borderRadius: 18, background: `rgba(${hexRgb(p.accent)},0.07)`, opacity: 0, transition: "opacity 0.2s ease", pointerEvents: "none", zIndex: 10 }} />
                  )}
                  <div style={{ marginBottom: 7 }}>
                    <span style={{ display: "inline-block", width: 6, height: 6, borderRadius: "50%", background: p.accent, boxShadow: isActive ? `0 0 10px ${p.accent}, 0 0 22px ${p.accent}88` : "none", marginRight: 7, verticalAlign: "middle", transition: "box-shadow 0.4s" }} />
                    <span style={{ fontSize: 9, letterSpacing: "0.18em", fontWeight: 800, textTransform: "uppercase" as const, color: p.accent, verticalAlign: "middle", fontFamily: "'Syne',sans-serif" }}>{p.label}</span>
                    {!isActive && <span style={{ float: "right", fontSize: 8, color: `rgba(${hexRgb(p.accent)},0.5)`, fontFamily: "'Syne',sans-serif", fontWeight: 600, letterSpacing: "0.05em", marginTop: 1 }}>tap ↗</span>}
                  </div>
                  <p style={{ fontSize: 12, fontWeight: 700, color: "#fff", margin: "0 0 4px", lineHeight: 1.3, fontFamily: "'Syne',sans-serif" }}>{p.title}</p>
                  <p style={{ fontSize: 10.5, color: "rgba(195,182,225,0.65)", margin: 0, lineHeight: 1.55, fontFamily: "'Syne',sans-serif" }}>{p.desc}</p>
                  <div style={{ position: "absolute", bottom: 0, left: 0, height: 2, background: p.accent, width: isActive ? "100%" : "0%", borderRadius: "0 0 18px 18px", boxShadow: isActive ? `0 0 8px ${p.accent}` : "none", transition: "width 0.4s ease, box-shadow 0.4s ease" }} />
                </GlassCard>
              </div>
            </div>
          ))}
            );
          })}
        </div>
      </section>

      {/* 5. FOOTER */}
      <footer className="relative z-10 py-20 flex flex-col items-center">
        <div className="flex -space-x-2 mb-6 opacity-50">
          {[1,2,3,4,5].map(i => (
            <div key={i} className="w-12 h-12 rounded-full border-4 border-[#020617] bg-blue-900/20" />
          ))}

        {/* Phone mockup */}
        <div style={{ perspective: 1100 }}>
          <div style={{ transform: "rotateY(-14deg) rotateX(4deg) rotateZ(1.5deg)", transformStyle: "preserve-3d", animation: "phoneFloat 5.5s ease-in-out infinite", filter: `drop-shadow(0 28px 56px ${activePhase.accent}50)`, transition: "filter 0.6s ease" }}>
            <div style={{ width: PW + 14, height: PH + 44, borderRadius: 30, background: "linear-gradient(145deg,#18182e,#0c0c1a)", border: "1.5px solid rgba(255,255,255,0.13)", boxShadow: "inset 0 0 0 1px rgba(255,255,255,0.05)", position: "relative", overflow: "visible", padding: "22px 7px 7px", boxSizing: "border-box" as const }}>
              <div style={{ position: "absolute", top: 8, left: "50%", transform: "translateX(-50%)", width: 46, height: 6, background: "#09091a", borderRadius: 6, zIndex: 10 }} />
              <PhoneVideo src={videoSrc} fallbackGradient={fallbackGrad} caption={activeCaption} phase={phase} PW={PW} PH={PH} screenRef={screenRef} />
              <div style={{ position: "absolute", right: -2.5, top: 64, width: 2.5, height: 30, background: "rgba(255,255,255,0.12)", borderRadius: "0 2px 2px 0" }} />
            </div>
          </div>
        </div>
        <p className="text-sm text-gray-500 font-medium tracking-wide">Trusted by 50,000+ creators & brands</p>
      </footer>
      </div>

      {/* Scroll cue */}
      <div style={{ position: "relative", zIndex: 2, marginTop: 52, display: "flex", flexDirection: "column", alignItems: "center", gap: 8, animation: "fadeUpIn 1s ease 1.2s both" }}>
        <span style={{ fontSize: 10, letterSpacing: "0.18em", color: "rgba(180,168,210,0.45)", textTransform: "uppercase", fontFamily: "'Syne',sans-serif" }}>Scroll to explore</span>
        <div style={{ width: 1, height: 36, background: "linear-gradient(to bottom,rgba(160,140,200,0.45),transparent)" }} />
      </div>

      <style>{`
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        
        @keyframes marquee {
          0% { transform: translateX(0); }
        @import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&display=swap');
        @keyframes shimmer    { 0%{background-position:0% center} 100%{background-position:200% center} }
        @keyframes phoneFloat {
          0%,100%{transform:rotateY(-14deg) rotateX(4deg) rotateZ(1.5deg) translateY(0)}
          50%    {transform:rotateY(-14deg) rotateX(4deg) rotateZ(1.5deg) translateY(-10px)}
        }
        @keyframes vidProg    { 0%{width:0%} 100%{width:100%} }
        @keyframes fadeUpIn   { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:translateY(0)} }
        @keyframes marqueeScroll {
          0%   { transform: translateX(0); }
          100% { transform: translateX(-50%); }
        }
        .marquee-container { width: 100%; display: flex; overflow: hidden; }
        .marquee-content {
          display: flex;
          white-space: nowrap;
          animation: marquee 40s linear infinite;
        .strategy-cards > div > div:hover .card-hover-hint { opacity: 1 !important; }
        .strategy-cards > div > div:hover { opacity: 0.62 !important; transform: scale(1.015) !important; }
        @media (max-width:900px){
          .phone-composition{ flex-direction:column !important; align-items:center !important; gap:24px !important; }
          .strategy-cards{ flex-direction:row !important; flex-wrap:wrap; justify-content:center; margin-right:0 !important; gap:8px !important; }
          .strategy-cards > div{ order:2; }
          .phone-composition > div:last-child{ order:1; }
          .strategy-cards > div > div{ width:calc(50vw - 28px) !important; min-width:140px; max-width:200px; }
        }
        @media (max-width:480px){
          .strategy-cards > div > div{ width:90vw !important; max-width:none; }
        }
      `}</style>
    </section>
  );
};

