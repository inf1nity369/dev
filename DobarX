const PremiumAdArchive = () => {
  const trackRef    = useRef<HTMLDivElement>(null);
  const isDragging  = useRef(false);
  const startX      = useRef(0);
  const scrollLeft  = useRef(0);
  const snapTimer   = useRef<ReturnType<typeof setTimeout> | null>(null);
  const videoRefs   = useRef<(HTMLVideoElement | null)[]>([]);

      {/* 2. HERO */}
      <section className="relative z-10 px-6 py-16 text-center max-w-4xl mx-auto">
        <div className="inline-block px-4 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-[9px] font-bold tracking-widest text-blue-400 mb-8 uppercase">
          ✨ High-Retention Video Ads
  // Card geometry
  const CARD_W  = 180;   // px — width of each phone card
  const CARD_H  = Math.round(CARD_W * 16 / 9); // strict 9:16
  const GAP     = 28;    // px between cards
  const STRIDE  = CARD_W + GAP;

  const [activeIdx, setActiveIdx] = useState(0);

  // ── Play / pause videos based on which card is active ──────────────────────
  useEffect(() => {
    videoRefs.current.forEach((v, i) => {
      if (!v) return;
      if (i === activeIdx) {
        v.play().catch(() => {});
      } else {
        v.pause();
        v.currentTime = 0;
      }
    });
  }, [activeIdx]);

  // ── Snap to nearest card center ────────────────────────────────────────────
  const snapToNearest = useCallback(() => {
    const track = trackRef.current; if (!track) return;
    const center = track.scrollLeft + track.clientWidth / 2;
    // offset: first card center is at GAP + CARD_W/2 from track start
    const firstCardCenter = GAP + CARD_W / 2;
    const nearest = Math.round((center - firstCardCenter) / STRIDE);
    const clamped = Math.max(0, Math.min(nearest, AD_CARDS.length - 1));
    setActiveIdx(clamped);
    // scroll so that card center aligns with track center
    const targetScroll = firstCardCenter + clamped * STRIDE - track.clientWidth / 2;
    track.scrollTo({ left: targetScroll, behavior: "smooth" });
  }, []);

  // ── Debounce snap after native scroll ends ─────────────────────────────────
  const onScroll = useCallback(() => {
    if (snapTimer.current) clearTimeout(snapTimer.current);
    snapTimer.current = setTimeout(snapToNearest, 120);
  }, [snapToNearest]);

  // ── Desktop: drag-to-scroll ────────────────────────────────────────────────
  const onMouseDown = (e: React.MouseEvent) => {
    isDragging.current = true;
    startX.current = e.pageX - (trackRef.current?.offsetLeft ?? 0);
    scrollLeft.current = trackRef.current?.scrollLeft ?? 0;
    if (trackRef.current) trackRef.current.style.cursor = "grabbing";
  };
  const onMouseMove = (e: React.MouseEvent) => {
    if (!isDragging.current || !trackRef.current) return;
    e.preventDefault();
    const x = e.pageX - trackRef.current.offsetLeft;
    const walk = (x - startX.current) * 1.4; // 1.4 = drag multiplier
    trackRef.current.scrollLeft = scrollLeft.current - walk;
  };
  const onMouseUp = () => {
    isDragging.current = false;
    if (trackRef.current) trackRef.current.style.cursor = "grab";
    snapToNearest();
  };

  // ── Dot nav ────────────────────────────────────────────────────────────────
  const goTo = (idx: number) => {
    const track = trackRef.current; if (!track) return;
    const firstCardCenter = GAP + CARD_W / 2;
    const targetScroll = firstCardCenter + idx * STRIDE - track.clientWidth / 2;
    track.scrollTo({ left: targetScroll, behavior: "smooth" });
    setActiveIdx(idx);
  };

  // ── Scroll to first card on mount ──────────────────────────────────────────
  useEffect(() => {
    const track = trackRef.current; if (!track) return;
    // Use requestAnimationFrame so layout is settled
    requestAnimationFrame(() => {
      const firstCardCenter = GAP + CARD_W / 2;
      track.scrollLeft = firstCardCenter - track.clientWidth / 2;
    });
  }, []);

  return (
    <section style={{
      position: "relative",
      background: "radial-gradient(ellipse 80% 60% at 50% 40%, #0b0520 0%, #060312 60%, #000 100%)",
      padding: "96px 0 80px",
      overflow: "hidden",
    }}>
      {/* Ambient glow behind carousel */}
      <div style={{ position: "absolute", width: 600, height: 400, borderRadius: "50%", top: "30%", left: "50%", transform: "translateX(-50%)", background: "radial-gradient(circle,rgba(120,40,255,0.12) 0%,transparent 70%)", filter: "blur(60px)", pointerEvents: "none" }} />

      {/* Section header */}
      <div style={{ textAlign: "center", marginBottom: 52, padding: "0 24px" }}>
        <div style={{ display: "inline-flex", alignItems: "center", gap: 8, background: "rgba(120,30,255,0.12)", border: "1px solid rgba(160,100,255,0.25)", borderRadius: 100, padding: "5px 18px", marginBottom: 20 }}>
          <span style={{ fontSize: 10, letterSpacing: "0.2em", color: "#c4a0ff", textTransform: "uppercase", fontWeight: 700, fontFamily: "'Syne',sans-serif" }}>📁 PREMIUM AD ARCHIVE</span>
        </div>
        <h2 className="text-5xl md:text-7xl font-bold mb-8 leading-tight tracking-tight">
          Ads That <br/><span className="text-blue-500">Stop The Scroll.</span>
        <h2 style={{ fontSize: "clamp(1.6rem,3.5vw,2.6rem)", fontWeight: 800, color: "#fff", margin: "0 0 12px", letterSpacing: "-0.02em", fontFamily: "'Syne',sans-serif" }}>
          The Work That{" "}
          <span style={{ background: "linear-gradient(90deg,#e879f9,#38bdf8,#4ade80)", WebkitBackgroundClip: "text", WebkitTextFillColor: "transparent" }}>
            Performs
          </span>
        </h2>
        <div className="flex flex-col sm:flex-row gap-4 justify-center items-center mt-10">
          <button className="w-full sm:w-auto px-10 py-4 bg-blue-600 rounded-2xl font-bold shadow-lg shadow-blue-600/20">Book a Call</button>
          <button className="w-full sm:w-auto px-10 py-4 bg-white/5 border border-white/10 rounded-2xl font-bold">My Work</button>
        </div>
      </section>

      {/* 3. THE STRATEGY SECTION */}
      <section className="relative z-10 py-24 px-6 max-w-5xl mx-auto">
        <h3 className="text-center text-3xl font-bold mb-16 tracking-tight">The Strategy</h3>
        <div className="grid md:grid-cols-2 gap-16 items-center">
          <div className="space-y-6 order-2 md:order-1">
            {Object.keys(strategyData).map((key) => (
              <div 
                key={key}
                onClick={() => setActivePhase(key)}
                className={`p-6 rounded-2xl border transition-all duration-300 cursor-pointer ${
                  activePhase === key 
                  ? 'bg-blue-600/10 border-blue-500 shadow-[0_0_30px_rgba(59,130,246,0.1)]' 
