// ─── Phone Video Player ───────────────────────────────────────────────────────
interface PhoneVideoProps {
  src: string; fallbackGradient: string; caption: string;
  phase: number; PW: number; PH: number;
  screenRef: React.RefObject<HTMLDivElement>;
}
const PhoneVideo = ({ src, fallbackGradient, caption, phase, PW, PH, screenRef }: PhoneVideoProps) => {
  const videoRef = useRef<HTMLVideoElement>(null);
  const [opacity, setOpacity] = useState(1);
  const prevSrc = useRef(src);

  useEffect(() => {
    if (src === prevSrc.current) return;
    setOpacity(0);
    const swap = setTimeout(() => {
      prevSrc.current = src;
      if (videoRef.current) { videoRef.current.load(); videoRef.current.play().catch(() => {}); }
      setOpacity(1);
    }, 300);
    return () => clearTimeout(swap);
  }, [src]);

  useEffect(() => { videoRef.current?.play().catch(() => {}); }, []);

  return (
    <div ref={screenRef} style={{ width: PW, height: PH, borderRadius: 16, overflow: "hidden", background: "#000", position: "relative", flexShrink: 0 }}>
      <div style={{ position: "absolute", inset: 0, background: fallbackGradient, transition: "background 0.5s ease", zIndex: 0 }} />
      <video ref={videoRef} key={src} muted loop playsInline autoPlay
        style={{ position: "absolute", inset: 0, width: "100%", height: "100%", objectFit: "cover", objectPosition: "center", borderRadius: 16, opacity, transition: "opacity 0.3s ease", zIndex: 1 }}>
        <source src={src} type="video/mp4" />
        <source src={src.replace(".mp4", ".webm")} type="video/webm" />
      </video>
      {/* Top bar */}
      <div style={{ position: "absolute", top: 10, left: 9, right: 9, display: "flex", justifyContent: "space-between", alignItems: "center", zIndex: 4 }}>
        <div style={{ display: "flex", alignItems: "center", gap: 4 }}>
          <div style={{ width: 18, height: 18, borderRadius: "50%", background: "rgba(255,255,255,0.9)" }} />
          <span style={{ color: "#fff", fontSize: 7.5, fontWeight: 700, textShadow: "0 1px 4px rgba(0,0,0,0.7)" }}>creator_name</span>
        </div>
        <span style={{ background: "rgba(255,0,70,0.9)", color: "#fff", fontSize: 6.5, fontWeight: 800, padding: "1px 5px", borderRadius: 3 }}>LIVE</span>
      </div>
      {/* Scrub bar */}
      <div style={{ position: "absolute", bottom: 44, left: 7, right: 7, height: 2, background: "rgba(255,255,255,0.18)", borderRadius: 2, overflow: "hidden", zIndex: 4 }}>
        <div style={{ height: "100%", background: "#fff", animation: "vidProg 1.8s linear infinite", borderRadius: 2 }} />
      </div>
      {/* Caption */}
      <div style={{ position: "absolute", bottom: 12, left: 7, right: 7, background: "rgba(0,0,0,0.62)", backdropFilter: "blur(4px)", borderRadius: 6, padding: "4px 7px", color: "#fff", fontSize: 8, fontWeight: 700, textAlign: "center", zIndex: 4 }}>
        {caption}
      </div>
      {/* Zone overlays */}
      {PHASES.map((p, i) => (
        <div key={i} style={{
          position: "absolute", left: 0, right: 0,
          top: i === 0 ? 0 : i === 1 ? "33.33%" : "66.66%", height: "33.34%",
          borderTop: i !== 2 ? `1.5px solid ${p.accent}` : "none",
          borderBottom: i !== 0 ? `1.5px solid ${p.accent}` : "none",
          borderLeft: "none", borderRight: "none",
          borderRadius: i === 0 ? "16px 16px 0 0" : i === 2 ? "0 0 16px 16px" : 0,
          boxShadow: `inset 0 0 16px ${p.accent}22`,
